<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="admin-topbar">
    <div class="topbar-context">
        <button class="sidebar-toggle" type="button" aria-controls="etudiant-sidebar" aria-expanded="true" aria-label="Réduire le menu" title="Réduire le menu" data-sidebar-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <nav class="topbar-breadcrumb" aria-label="Fil d’Ariane">
            <span class="crumb-root">Espace étudiant</span>
            <span class="crumb-sep" aria-hidden="true">/</span>
            <span class="crumb-current" aria-current="page"><c:out value="${titre}"/></span>
        </nav>
    </div>
    <div class="topbar-actions">
        <c:if test="${type ne 'ma-soutenance'}">
            <a class="topbar-quick" href="${pageContext.request.contextPath}/etudiant/ma-soutenance">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v15H4zM8 5V3h8v2M8 10h8m-8 4h8m-8 4h5"/></svg>
                Ma soutenance
            </a>
        </c:if>
    </div>
    <div class="topbar-account">
        <span class="account-avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(etudiant.prenom, 0, 1))}${fn:toUpperCase(fn:substring(etudiant.nom, 0, 1))}"/></span>
        <span class="account-label">
            <strong><c:out value="${etudiant.prenom}"/> <c:out value="${etudiant.nom}"/></strong>
            <span class="role-badge topbar-role role-ETUDIANT">Étudiant</span>
        </span>
    </div>
</header>
