<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="admin-rail">
<a class="skip-link" href="#main-content">Aller au contenu principal</a>
<aside class="admin-sidebar" id="admin-sidebar">
    <a class="brand" href="${pageContext.request.contextPath}/admin/departements">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z"/><path d="M6.5 11.2v5.3c3.2 2.5 7.8 2.5 11 0v-5.3M21.5 9v6"/></svg>
        </span>
        <span class="brand-copy"><strong>Soutenances EE</strong><small>Portail Administration</small></span>
    </a>
    <p class="nav-heading">Paramètres généraux</p>
    <nav class="admin-nav" aria-label="Paramètres généraux">
        <details class="nav-group" name="admin-nav" title="Gestion des Grades" ${type eq 'grades' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg></span>Gestion des Grades</summary>
            <div class="nav-submenu">
                <a class="${type eq 'grades' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/grades">Liste des Grades</a>
                <a class="${param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/grades?vue=form">Ajout / Édition Grade</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion des Départements" ${type eq 'departements' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 21V5l8-3 8 3v16M2 21h20M8 8h1m6 0h1M8 12h1m6 0h1M10 21v-5h4v5"/></svg></span>Gestion des Départements</summary>
            <div class="nav-submenu">
                <a class="${type eq 'departements' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/departements">Liste des Départements</a>
                <a class="${param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/departements?vue=form">Ajout / Édition Département</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion des Filières" ${type eq 'filieres' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="12" cy="19" r="2"/><path d="M7 5h10M6 7l5 10m7-10-5 10"/></svg></span>Gestion des Filières</summary>
            <div class="nav-submenu">
                <a class="${type eq 'filieres' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/filieres">Liste des Filières</a>
                <a class="${param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/filieres?vue=form">Ajout / Édition Filière</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion des Salles" ${type eq 'salles' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 21V3h16v18M2 21h20M9 21v-5h6v5M8 7h.01M12 7h.01M16 7h.01M8 11h.01M16 11h.01"/></svg></span>Gestion des Salles</summary>
            <div class="nav-submenu">
                <a class="${type eq 'salles' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/salles">Liste des Salles</a>
                <a class="${param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/salles?vue=form">Ajout / Édition Salle</a>
            </div>
        </details>
    </nav>
    <p class="nav-heading">Acteurs &amp; Comptes</p>
    <nav class="admin-nav" aria-label="Acteurs et comptes">
        <details class="nav-group" name="admin-nav" title="Gestion des Encadreurs" ${type eq 'encadreurs' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0M19 8h3m-1.5-1.5v3"/></svg></span>Gestion des Encadreurs</summary>
            <div class="nav-submenu">
                <a class="${type eq 'encadreurs' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/encadreurs">Liste des Encadreurs</a>
                <a class="${type eq 'encadreurs' and param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/encadreurs?vue=form">Ajout / Édition Encadreur</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion des Étudiants" ${type eq 'etudiants' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0m2-9h5m-2.5-2.5v5"/></svg></span>Gestion des Étudiants</summary>
            <div class="nav-submenu">
                <a class="${type eq 'etudiants' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/etudiants">Liste des Étudiants</a>
                <a class="${type eq 'etudiants' and param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/etudiants?vue=form">Ajout / Édition Étudiant</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion des Comptes" ${type eq 'utilisateurs' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0m3-9 2 2 4-4"/></svg></span>Gestion des Comptes</summary>
            <div class="nav-submenu">
                <a class="${type eq 'utilisateurs' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/utilisateurs">Liste des Comptes</a>
            </div>
        </details>
    </nav>
    <p class="nav-heading">Académique &amp; Soutenances</p>
    <nav class="admin-nav" aria-label="Académique et soutenances">
        <details class="nav-group" name="admin-nav" title="Gestion des Mémoires" ${type eq 'memoires' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5Z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M8 7h8m-8 4h5"/></svg></span>Gestion des Mémoires</summary>
            <div class="nav-submenu">
                <a class="${type eq 'memoires' and empty param.vue ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/memoires">Liste des Mémoires</a>
                <a class="${type eq 'memoires' and param.vue eq 'form' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/memoires?vue=form">Ajout / Édition Mémoire</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Planification &amp; Jurys" ${(type eq 'planification' or type eq 'jury' or (type eq 'soutenances' and param.vue eq 'jurys')) ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v15H4z"/><path d="M8 3v4m8-4v4M4 10h16"/><path d="M8 14h3m5 0h.01"/></svg></span>Planification &amp; Jurys</summary>
            <div class="nav-submenu">
                <a class="${type eq 'planification' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/planification">Formulaire de Soutenance</a>
                <a class="${type eq 'jury' or (type eq 'soutenances' and param.vue eq 'jurys') ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/soutenances?vue=jurys">Composition du Jury</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Gestion Globale des Soutenances" ${type eq 'soutenances' and param.vue ne 'jurys' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v15H4z"/><path d="M8 3v4m8-4v4M4 10h16"/><path d="m8 15 2 2 4-4"/></svg></span>Gestion Globale des Soutenances</summary>
            <div class="nav-submenu">
                <a class="${type eq 'soutenances' and param.vue ne 'jurys' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/soutenances">Vue Globale des Soutenances</a>
            </div>
        </details>
    </nav>
    <p class="nav-heading">Pilotage &amp; audit</p>
    <nav class="admin-nav" aria-label="Pilotage et audit">
        <details class="nav-group" name="admin-nav" title="Tableau de Bord &amp; Statistiques" ${type eq 'dashboard' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 2 5-6"/><circle cx="7" cy="15" r="1"/><circle cx="11" cy="11" r="1"/><circle cx="14" cy="13" r="1"/><circle cx="19" cy="7" r="1"/></svg></span>Tableau de Bord &amp; Statistiques</summary>
            <div class="nav-submenu">
                <a class="${type eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/dashboard">Vue d’ensemble &amp; indicateurs</a>
            </div>
        </details>
        <details class="nav-group" name="admin-nav" title="Historique &amp; Traçabilité" ${type eq 'historique' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v15H4z"/><path d="M8 5V3h8v2M8 10h8m-8 4h8m-8 4h5"/></svg></span>Historique &amp; Traçabilité</summary>
            <div class="nav-submenu">
                <a class="${type eq 'historique' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/historique">Journal d'Audit</a>
            </div>
            <script src="${pageContext.request.contextPath}/assets/js/sidebar-toggle.js?v=20261032" defer></script>
        </details>
    </nav>
    <form class="sidebar-logout" method="post" action="${pageContext.request.contextPath}/logout">
        <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>">
        <button type="submit"><svg class="logout-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 17l5-5-5-5M15 12H3M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg><span>Se déconnecter</span></button>
    </form>
<script src="${pageContext.request.contextPath}/assets/js/prevent-double-submit.js" defer></script>
</aside>
</div>
