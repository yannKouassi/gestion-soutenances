<%@ page pageEncoding="UTF-8" %>
<header class="admin-topbar">
    <div class="topbar-context">
        <button class="sidebar-toggle" type="button" aria-controls="admin-sidebar" aria-expanded="true" aria-label="Réduire le menu" title="Réduire le menu" data-sidebar-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div>
            <span class="topbar-eyebrow">Espace administrateur</span>
            <span class="topbar-section"><c:choose><c:when test="${type eq 'historique'}">Pilotage &amp; audit</c:when><c:when test="${type eq 'memoires' or type eq 'planification' or type eq 'jury' or type eq 'soutenances'}">Académique &amp; Soutenances</c:when><c:otherwise>Paramètres généraux</c:otherwise></c:choose></span>
        </div>
    </div>
    <div class="topbar-account">
        <span class="account-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
        <span class="account-label"><strong>Administration</strong><small>Compte administrateur</small></span>
    </div>
</header>
