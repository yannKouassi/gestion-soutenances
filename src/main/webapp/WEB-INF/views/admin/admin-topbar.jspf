<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="crumbSection" value="Paramètres généraux"/>
<c:choose>
    <c:when test="${type eq 'historique' or type eq 'dashboard'}"><c:set var="crumbSection" value="Pilotage et audit"/></c:when>
    <c:when test="${type eq 'memoires' or type eq 'planification' or type eq 'jury' or type eq 'soutenances'}"><c:set var="crumbSection" value="Académique et Soutenances"/></c:when>
    <c:when test="${type eq 'encadreurs' or type eq 'etudiants' or type eq 'utilisateurs'}"><c:set var="crumbSection" value="Acteurs et comptes"/></c:when>
</c:choose>
<header class="admin-topbar">
    <div class="topbar-context">
        <button class="sidebar-toggle" type="button" aria-controls="admin-sidebar" aria-expanded="true" aria-label="Réduire le menu" title="Réduire le menu" data-sidebar-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <nav class="topbar-breadcrumb" aria-label="Fil d’Ariane">
            <span class="crumb-root">Espace administration</span>
            <span class="crumb-sep" aria-hidden="true">/</span>
            <span class="crumb-section"><c:out value="${crumbSection}"/></span>
            <span class="crumb-sep crumb-sep-section" aria-hidden="true">/</span>
            <span class="crumb-current" aria-current="page"><c:out value="${titre}"/></span>
        </nav>
    </div>
    <div class="topbar-actions">
        <c:if test="${type ne 'dashboard'}">
            <a class="topbar-quick" href="${pageContext.request.contextPath}/admin/dashboard">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 13h7V4H4zM13 20h7v-9h-7zM4 20h7v-4H4zM13 8h7V4h-7z"/></svg>
                Tableau de bord
            </a>
        </c:if>
    </div>
    <div class="topbar-account">
        <span class="account-avatar" aria-hidden="true"><c:out value="${fn:toUpperCase(fn:substring(sessionScope.utilisateurConnecte.login, 0, 1))}"/></span>
        <span class="account-label">
            <strong><c:out value="${sessionScope.utilisateurConnecte.login}"/></strong>
            <span class="role-badge topbar-role role-${sessionScope.utilisateurConnecte.role}"><c:out value="${sessionScope.utilisateurConnecte.role}"/></span>
        </span>
    </div>
</header>
