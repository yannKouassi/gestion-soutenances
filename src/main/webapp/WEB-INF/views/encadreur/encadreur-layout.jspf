<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="admin-rail">
<aside class="admin-sidebar" id="encadreur-sidebar">
    <a class="brand" href="${pageContext.request.contextPath}/encadreur/dashboard">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z"/><path d="M6.5 11.2v5.3c3.2 2.5 7.8 2.5 11 0v-5.3M21.5 9v6"/></svg>
        </span>
        <span class="brand-copy"><strong>Soutenances EE</strong><small>Portail Encadreur</small></span>
    </a>
    <p class="nav-heading">Menu Encadreur</p>
    <nav class="admin-nav" aria-label="Espace encadreur">
        <details class="nav-group" name="encadreur-nav" title="Tableau de Bord" ${type eq 'dashboard' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 2 5-6"/><circle cx="7" cy="15" r="1"/><circle cx="11" cy="11" r="1"/><circle cx="14" cy="13" r="1"/><circle cx="19" cy="7" r="1"/></svg></span>Tableau de Bord</summary>
            <div class="nav-submenu">
                <a class="${type eq 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/encadreur/dashboard">Résumé / Alertes</a>
            </div>
        </details>
        <details class="nav-group" name="encadreur-nav" title="Mes Étudiants Encadrés" ${type eq 'mes-etudiants' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0m2-9h5m-2.5-2.5v5"/></svg></span>Mes Étudiants Encadrés</summary>
            <div class="nav-submenu">
                <a class="${type eq 'mes-etudiants' ? 'active' : ''}" href="${pageContext.request.contextPath}/encadreur/mes-etudiants">Liste étudiants encadrés</a>
            </div>
        </details>
        <details class="nav-group" name="encadreur-nav" title="Mes jurys et évaluations" ${type eq 'mes-jurys' or type eq 'evaluation' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0m2-9h5m-2.5-2.5v5"/></svg></span>Mes jurys &amp; évaluations</summary>
            <div class="nav-submenu">
                <a class="${type eq 'mes-jurys' ? 'active' : ''}" href="${pageContext.request.contextPath}/encadreur/mes-jurys">Liste des Jurys</a>
                <a class="${type eq 'evaluation' ? 'active' : ''}" href="${pageContext.request.contextPath}/encadreur/saisie-evaluation">Saisie d’évaluation</a>
            </div>
        </details>
        <details class="nav-group" name="encadreur-nav" title="Mon Profil" ${type eq 'profil' ? 'open' : ''}>
            <summary><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>Mon Profil</summary>
            <div class="nav-submenu">
                <a class="${type eq 'profil' ? 'active' : ''}" href="${pageContext.request.contextPath}/encadreur/profil">Édition Profil</a>
            </div>
            <script src="${pageContext.request.contextPath}/assets/js/sidebar-toggle.js?v=20261027-2" defer></script>
        </details>
    </nav>
    <form class="sidebar-logout" method="post" action="${pageContext.request.contextPath}/logout">
        <input type="hidden" name="csrfToken" value="<c:out value='${logoutCsrfToken}'/>">
        <button type="submit" title="Se déconnecter"><svg class="logout-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 17l5-5-5-5M15 12H3M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg><span>Se déconnecter</span></button>
    </form>
</aside>
</div>
