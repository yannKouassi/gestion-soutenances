<%@ page pageEncoding="UTF-8" %>
<header class="admin-topbar">
    <div class="topbar-context">
        <span class="topbar-mark" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 6h16M7 12h10m-7 6h4"/><circle cx="8" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="12" cy="18" r="2"/></svg></span>
        <div>
            <span class="topbar-eyebrow">Espace encadreur</span>
            <span class="topbar-section"><c:out value="${titre}"/></span>
        </div>
    </div>
    <div class="topbar-account">
        <span class="account-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
        <span class="account-label"><strong><c:out value="${encadreur.prenom}"/> <c:out value="${encadreur.nom}"/></strong><small>Compte encadreur</small></span>
    </div>
</header>
