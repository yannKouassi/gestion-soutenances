# SMTP configuration example for local WildFly.
# Copy this file to .env (ignored by Git), then replace the example values.
# Never commit a real SMTP password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM="votre.adresse@gmail.com"
SMTP_USERNAME="votre.adresse@gmail.com"
SMTP_PASSWORD=remplacer-par-votre-mot-de-passe-d-application
SMTP_STARTTLS=true
SMTP_SSL=false
