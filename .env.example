# .env.example — modèle de la configuration SMTP du serveur WildFly local.
#
# Copie ce fichier en `.env` (déjà ignoré par Git) et remplace les valeurs.
# `.scripts\redeploy.ps1` lit `.env` et exporte chaque variable dans
# l'environnement du processus WildFly avant son démarrage.
#
# Format : une variable par ligne, `CLE=valeur`, pas d'espace autour du `=`.
# Les lignes vides et les lignes commençant par `#` sont ignorées.
# Les guillemets autour de la valeur sont optionnels.

# ----------------------------------------------------------------obligatoires--

# Nom d'hôte du serveur SMTP, sans espace.
SMTP_HOST=smtp.gmail.com

# Adresse d'expédition, entre guillemets pour garder le format lisible.
# Doit être l'adresse Gmail authentifiée ci-dessous.
SMTP_FROM="votre.adresse@gmail.com"

# Login SMTP = adresse e-mail complète du compte Gmail.
SMTP_USERNAME="votre.adresse@gmail.com"

# Mot de passe d'application Gmail (16 caractères), PAS le mot de passe du
# compte. Generate at https://myaccount.google.com/apppasswords
# (validation en deux étapes obligatoire au préalable).
SMTP_PASSWORD="abcd efgh ijkl mnop"

# ----------------------------------------------------------------optionnelles--

# 587 = STARTTLS, 465 = TLS implicite. Défaut : 587 si SMTP_SSL est absent.
SMTP_PORT=587

# true = STARTTLS (recommandé avec le port 587).
# SMTP_SSL=true bascule sur TLS implicite et désactive STARTTLS.
# Les deux ne peuvent jamais être vrais en même temps.
SMTP_STARTTLS=true

# SMTP_SSL=true